# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---------- 临时文件（诊断、草稿、试验） ----------
_*.txt
_*.log
scratch/
tmp/
*.tmp

# ---------- 运行日志（run.ps1 / verify_e2e.py 产生） ----------
logs/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---------- 密钥与环境变量（绝对不能提交） ----------
.env
.env.*
!.env.example

# ---------- 本地数据库 / 生成物 ----------
*.db
*.sqlite3
ai-lab/data/out/*.csv

# ---------- 本地工具链（解释器、依赖缓存，体积大且可重建） ----------
.tools/

