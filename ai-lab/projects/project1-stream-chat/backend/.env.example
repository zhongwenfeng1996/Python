# .env 示例 —— 复制为 .env 并填空
#
# Windows:  Copy-Item .env.example .env
# macOS:    cp .env.example .env
#
# 最少填一个 provider 的 Key 就能跑真实调用。
# 什么都不填也能跑 —— 配合仓库自带的 mock 服务（见 README 的"离线运行"）。

# ---- 国产：DeepSeek（便宜，推荐先用这个）----
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- 国产：阿里百炼 / 通义千问 ----
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ---- 闭源：OpenAI ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- 国产：智谱 GLM（有免费额度）----
# https://open.bigmodel.cn/
ZHIPU_API_KEY=

# ---- 可选：覆盖所有模型的 base_url ----
# 指向本地 mock 时不需要任何真实 Key：
#   OPENAI_BASE_URL=http://127.0.0.1:8765/v1
OPENAI_BASE_URL=

# ---- 可选：超时策略（秒）----
# 首 token 超时：超过就降级到备用模型。调大=更耐慢模型，调小=降级更激进。
FIRST_TOKEN_TIMEOUT_S=8
# 单次请求总超时：长回答需要足够的时间。
CHAT_TIMEOUT_S=60
